# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# secret env files — never commit any key material
.env
.env*
.env.matcher

# persistent AI confirmation cache — local data, not committed
data/confirmation-cache.json
# per-market resolution signature cache — local data, not committed
data/resolution-signatures.json
# live scan outputs — rewritten each cycle, never committed
data/liquidity-rewards.json
data/kalshi-rewards.json
# bot alert state — contains Telegram chat IDs (personal data)
data/fund-subscriptions.json
data/copy-watchlist.json
# monitor auto-restart circuit-breaker ledger — runtime state, self-heals
data/monitor-restart-ledger.json
# copy-trading runtime state — position snapshots, open/close events, paper positions
# (all rewritten/appended at runtime, local data, never source-controlled)
data/copy-events.json
data/copy-position-state.json
data/paper-positions.json
# durable 14-day per-leg settled-funding history — grows organically at runtime, local data
data/funding-history-14d.json
data/funding-history-14d.json.tmp.*
# sports arb scanner outputs — rewritten each scan, credit state is local
data/sports/
# runtime SQLite DB — written continuously by agent5-calculator, not source-controlled
data/opportunities.db
data/opportunities.db-wal
data/opportunities.db-shm
# cron runtime logs — appended by system crontab, not source-controlled
logs/

data/fund-subscriptions.json
data/liquidity-rewards.json

public/funding-opportunities.json
public/latest-opportunities.json

# editor backup files
*.save
*.orig
*.bak
