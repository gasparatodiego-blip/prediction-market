@tailwind base;
@tailwind components;
@tailwind utilities;

/* STILE ISTITUZIONALE PROFESSIONALE */
/* Bloomberg / Reuters / FactSet style */

:root {
  --bg: #000000;
  --surface: #0d0d0d;
  --elevated: #141414;
  --border: #2a2a2a;
  --brand: #1a5c9e;
  --brand-light: #2a6eb0;
  --profit: #2ecc71;
  --loss: #e74c3c;
  --warn: #f39c12;
  --ink: #ffffff;
  --muted: #888888;
  --faint: #555555;
}

* { 
  box-sizing: border-box; 
  border-radius: 0px !important;
}

html { 
  scroll-behavior: smooth; 
}

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  background: var(--bg);
  color: var(--ink);
  font-size: 13px;
  line-height: 1.4;
  -webkit-font-smoothing: antialiased;
}

/* Scrollbar sottile e professionale */
::-webkit-scrollbar {
  width: 4px;
  height: 4px;
}
::-webkit-scrollbar-track {
  background: var(--surface);
}
::-webkit-scrollbar-thumb {
  background: var(--faint);
}
::-webkit-scrollbar-thumb:hover {
  background: var(--muted);
}

/* Niente animazioni inutili */
* {
  animation: none !important;
  transition: none !important;
}

/* Testo selezionato */
::selection {
  background: var(--brand);
  color: white;
}

/* Focus stile corporate */
*:focus-visible {
  outline: 1px solid var(--brand);
  outline-offset: 1px;
}

/* Numeri tabulari (allineati perfettamente) */
.tabular-nums {
  font-variant-numeric: tabular-nums;
}

/* Card stile terminale Bloomberg */
.card, .glass, .backdrop-blur-sm, .bg-gray-900\/50 {
  background-color: var(--surface) !important;
  backdrop-filter: none !important;
  border: 1px solid var(--border) !important;
  box-shadow: none !important;
}

/* Pulsanti istituzionali */
button, .btn {
  border-radius: 0px !important;
  font-weight: 500;
  font-size: 12px;
  padding: 6px 12px;
}

button.bg-purple-600,
.btn-primary {
  background-color: var(--brand) !important;
}

button.bg-purple-600:hover,
.btn-primary:hover {
  background-color: var(--brand-light) !important;
}

/* Tabelle dense (stile Bloomberg) */
table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}

th {
  text-align: left;
  padding: 8px 12px;
  background-color: var(--surface);
  color: var(--muted);
  font-weight: 500;
  border-bottom: 1px solid var(--border);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  font-size: 11px;
}

td {
  padding: 8px 12px;
  border-bottom: 1px solid var(--border);
  color: var(--ink);
}

tr:hover td {
  background-color: var(--elevated);
}

/* Numeri positivi/negativi */
.text-green-400, .text-green-500, .text-green-600 {
  color: var(--profit) !important;
}

.text-red-400, .text-red-500, .text-red-600 {
  color: var(--loss) !important;
}

.text-yellow-400, .text-yellow-500 {
  color: var(--warn) !important;
}

/* Badge professionali */
.badge {
  display: inline-block;
  padding: 2px 6px;
  font-size: 10px;
  font-weight: 500;
  text-transform: uppercase;
  background-color: var(--elevated);
  border: 1px solid var(--border);
  color: var(--muted)
