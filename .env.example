# .env.example — template only. NO REAL VALUES IN THIS FILE.
#
# Copy to .env and fill in. `.env` is gitignored (see .gitignore); this template is the
# only env file that is tracked, via the `!.env.example` negation.
#
# WHY THIS FILE EXISTS: secrets must never be inlined into tracked files. In particular
# agents/ecosystem.config.js is tracked and read by pm2 — it references
# process.env.ADMIN_ACCESS_SECRET and loads it from .env through the minimal loader at the
# top of that file (dotenv is not installed). Putting a literal secret in the pm2 env block
# publishes it to GitHub on the next commit.

# ── Admin access ─────────────────────────────────────────────────────────────────────────
# Gates /settings, /dashboard/maker and /api/maker in middleware.ts; also the signing secret
# for the admin session cookie (lib/admin-session.ts). If unset, those routes 404 entirely.
# Consumed by the Next.js dashboard AND injected into agent35-maker via ecosystem.config.js.
# Generate:  openssl rand -base64 32
ADMIN_ACCESS_SECRET=

# NextAuth session signing secret. Generate a REAL value and paste it — do not commit a
# placeholder string, and check that the written line is the generated value, not the
# literal name of the variable you meant to substitute.
# Generate:  openssl rand -base64 32
NEXTAUTH_SECRET=

# ── Data ─────────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME"

# Master key for the key-custody envelope (wraps each ExchangeKey row's DEK).
# Losing this makes every stored venue key undecryptable.
KEY_CUSTODY_MASTER=

# ── Chain ────────────────────────────────────────────────────────────────────────────────
POLYGON_RPC_URL="https://polygon-bor-rpc.publicnode.com"

# DRY-TEST OVERRIDE ONLY. Overrides the PROXY address whose funds/allowances are read
# (see scripts/maker-wallet-preflight.ts). It does NOT change which wallet signs or settles —
# that is resolved signer -> proxy from the ExchangeKey row. Leaving this set in production
# makes the dashboard report a different wallet's balance than the one actually traded from.
MAKER_WALLET_ADDRESS=

# ── Maker engine (staged activation ladder) ──────────────────────────────────────────────
# off | paper | live-min | live   — 'off' and 'paper' can never reach the venue.
# NOTE: anything other than off/paper/live-min/live normalises to 'off' (lib/maker/config.js).
MAKER_MODE=off

# Attests that pUSD is funded AND the ERC-20 + ERC-1155 approvals are granted to the v2
# contracts. The placement gate refuses without it. Setting it does not make it true.
MAKER_FUNDING_APPROVED=

# live-min scope: the single conditionId allowed to quote, and the hard per-order cap in USD.
MAKER_LIVE_MIN_MARKET=
MAKER_LIVE_MIN_CAP_USD=25

# Venue-native GTD expiry per order. Venue floor is 180s; must exceed the refresh interval.
MAKER_ORDER_TTL_SECONDS=180

# Independent belts, both override the mode:
#   MAKER_ADAPTER_DRYRUN=true  → force shadow regardless of mode
#   MAKER_KILL=true            → halt everything and cancel all resting orders
MAKER_ADAPTER_DRYRUN=
MAKER_KILL=

# ── Quoting parameters ───────────────────────────────────────────────────────────────────
CAPITAL_USD=200
OFFSET_TICKS=1
MAX_MARKETS=10
