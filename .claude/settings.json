{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Bash(*)",
      "Edit",
      "Edit(*)",
      "Read",
      "Read(*)",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Task",
      "TodoWrite",
      "NotebookEdit"
    ],
    "ask": [
      "Bash(*/api/maker/manual/order*)",
      "Bash(*/api/maker/manual/replace*)",
      "Bash(*/api/maker/manual/cancel*)",
      "Bash(*/api/maker/manual/bulk-allocate*)",
      "Bash(*maker-live-test-order*)",
      "Bash(*maker-dryrun-place*)",
      "Bash(node*agent35-maker*)",
      "Bash(node*agent40-manual-reprice*)",

      "Bash(*/api/maker/arm*)",
      "Bash(*/api/maker/disarm*)",
      "Edit(//root/rewards-bot/data/maker-arming.json)",
      "Bash(*MAKER_PLACEMENT*)",
      "Bash(*MANUAL_ORDER_PLACEMENT*)",
      "Bash(*MAKER_MODE=live*)",
      "Bash(*MAKER_MODE=on*)",
      "Bash(*MAKER_FUNDING_APPROVED*)",

      "Edit(//root/rewards-bot/data/maker-bot-enabled.json)",
      "Bash(*>*bot-enabled*)",
      "Bash(*tee*bot-enabled*)",
      "Bash(*sed *bot-enabled*)",
      "Bash(*rm *bot-enabled*)",
      "Bash(*mv *bot-enabled*)",
      "Bash(*cp *bot-enabled*)",
      "Bash(*touch *bot-enabled*)",
      "Bash(*truncate*bot-enabled*)",
      "Bash(*node*bot-enabled*)",
      "Bash(*python*bot-enabled*)",
      "Bash(*perl*bot-enabled*)",
      "Bash(*git checkout*bot-enabled*)",
      "Bash(*git restore*bot-enabled*)",
      "Bash(*>*impostaBot*)",
      "Bash(*node*impostaBot*)",
      "Bash(*curl*api/maker/bot*)",
      "Bash(*wget*api/maker/bot*)",
      "Bash(*node*api/maker/bot*)",
      "Bash(*>*api/maker/bot*)",

      "Edit(//root/rewards-bot/data/safety-kill-switch.json)",
      "Bash(*>*safety-kill*)",
      "Bash(*tee*safety-kill*)",
      "Bash(*sed *safety-kill*)",
      "Bash(*rm *safety-kill*)",
      "Bash(*mv *safety-kill*)",
      "Bash(*cp *safety-kill*)",
      "Bash(*touch *safety-kill*)",
      "Bash(*truncate*safety-kill*)",
      "Bash(*node*safety-kill*)",
      "Bash(*python*safety-kill*)",
      "Bash(*perl*safety-kill*)",
      "Bash(*sh *safety-kill*)",
      "Bash(*git checkout*safety-kill*)",
      "Bash(*git restore*safety-kill*)",
      "Bash(*>*kill-maker*)",
      "Bash(*rm *kill-maker*)",
      "Bash(*mv *kill-maker*)",
      "Bash(*cp *kill-maker*)",
      "Bash(*sed *kill-maker*)",
      "Bash(*sh *kill-maker*)",
      "Bash(*./*kill-maker*)",
      "Bash(*node*kill-maker*)",
      "Bash(*curl*/api/maker/kill*)",
      "Bash(*wget*/api/maker/kill*)",
      "Bash(*node*/api/maker/kill*)",
      "Bash(*>*/api/maker/kill*)",

      "Edit(//root/rewards-bot/.env)",
      "Edit(//root/rewards-bot/.env.*)",
      "Edit(//root/rewards-bot/agents/ecosystem.config.js)",
      "Bash(*> /root/rewards-bot/.env*)"
    ]
  }
}
