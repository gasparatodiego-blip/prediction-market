@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --bg:       #0a0a0f;
  --surface:  #111118;
  --elevated: #1a1a24;
  --border:   #2a2a3a;
  --brand:    #6366f1;
  --profit:   #22c55e;
  --warn:     #f59e0b;
  --loss:     #ef4444;
  --ink:      #f1f5f9;
  --muted:    #94a3b8;
  --faint:    #475569;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }

body {
  font-family: 'Inter', system-ui, sans-serif;
  background: var(--bg);
  color: var(--ink);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Scrollbar */
::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 99px; }
::-webkit-scrollbar-thumb:hover { background: var(--faint); }

/* Selection */
::selection { background: rgba(99,102,241,0.25); color: var(--ink); }

/* Focus */
*:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; border-radius: 4px; }

/* Tabular numbers */
.tabnum { font-variant-numeric: tabular-nums; }

/* Live pulse dot */
@keyframes live-pulse { 0%,100% { opacity:1; } 50% { opacity:0.35; } }
.live-dot { animation: live-pulse 2s ease-in-out infinite; }

/* Float card */
@keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
.float { animation: float 4s ease-in-out infinite; }

/* Marquee */
@keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
.marquee { animation: marquee 32s linear infinite; }

/* Fade mask for marquee */
.fade-edges {
  -webkit-mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent);
  mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent);
}

/* Card hover */
.card-hover { transition: border-color 150ms ease, transform 150ms ease, box-shadow 150ms ease; }
.card-hover:hover {
  border-color: rgba(99,102,241,0.35) !important;
  transform: translateY(-1px);
  box-shadow: 0 8px 32px rgba(99,102,241,0.07);
}

/* Grid background */
.grid-bg {
  background-image:
    linear-gradient(rgba(99,102,241,0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(99,102,241,0.04) 1px, transparent 1px);
  background-size: 40px 40px;
}

/* Indigo gradient text */
.text-brand-gradient {
  background: linear-gradient(135deg, #818cf8, #a78bfa);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Glass surface */
.glass {
  background: rgba(17,17,24,0.9);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

/* Confidence gradient bar fill */
.conf-fill { background: linear-gradient(90deg, #f59e0b, #22c55e); }

/* Urgency HIGH pulse */
@keyframes urgency-pulse { 0%,100% { opacity:1; } 50% { opacity:0.6; } }
.urgency-high { animation: urgency-pulse 1.5s ease-in-out infinite; }

@layer utilities {
  .text-balance { text-wrap: balance; }
}
