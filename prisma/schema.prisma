generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String?
  googleId            String?   @unique
  telegramChatId      String?
  alertPrefs          Json?
  name                String?
  role                String    @default("user")   // 'user' | 'admin'
  plan                String    @default("free")
  planExpiresAt       DateTime?
  profitShareBalance  Float     @default(0)
  totalProfitTracked  Float     @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  preferences       UserPreferences?
  trackedOpps       TrackedOpportunity[]
  portfolio         Portfolio?
  alerts            Alert[]
  subscriptions     Subscription[]
  copyConfigs       CopyConfig[]
  rewardsPlacements RewardsPlacement[]
  exchangeKeys      ExchangeKey[]
}

// Exchange API credentials. Storage layer only — no venue client, no signing, no
// order path reads this yet (AUTO_EXECUTE_ENABLED=false).
//
// Envelope encryption. Each ROW carries its own random 32-byte DEK. The DEK
// encrypts the credential fields; the master (KEK) encrypts only the DEK. So
// rotating the master re-wraps `dekEnc` and never touches the field ciphertext —
// see lib/key-custody.ts rotateRow().
//
// Every credential column holds AES-256-GCM ciphertext produced by
// lib/key-custody.ts under this row's DEK. NOTHING here is plaintext, including
// apiKeyEnc: the api key identifies the account and is a secret, not a
// "public part".
//
// passphraseEnc is nullable because it is a per-venue fact, not an optional
// preference — OKX requires one, Binance has no such concept. A non-null column
// would force a fabricated value for venues that do not issue one.
//
// Revocation is `revokedAt`, never a DELETE: a key that once had account access
// must stay auditable after it is retired.
//
// Deliberately absent: any permissions/scopes column. We do not yet read scopes
// back from the venue, and a column asserting a scope we never verified would be
// a fabricated field.
model ExchangeKey {
  id            String    @id @default(cuid())
  userId        String
  venue         String                              // 'binance' | 'okx' | 'bybit' | ...
  label         String                              // user-facing name for this key
  apiKeyEnc     String?                             // AES-256-GCM under dek; NULL for venues with no api key (e.g. dYdX, which authenticates with an authenticator private key only)
  apiSecretEnc  String                              // AES-256-GCM under dek: iv:authTag:ciphertext (base64). For dYdX this is the authenticator PRIVATE KEY.
  passphraseEnc String?                             // AES-256-GCM under dek; null for venues with no passphrase
  // NON-SECRET identifiers, stored in PLAINTEXT by design. These are public
  // identifiers (a bech32 address, an integer id) — not credentials — and must be
  // readable to build a verification query. They are deliberately NOT encrypted and
  // deliberately NOT crammed into apiKeyEnc/passphraseEnc, whose meaning is
  // "encrypted secret". Only dYdX populates these today.
  accountAddress   String?                          // e.g. dYdX bech32 'dydx1...' owner address
  accountId        String?                          // e.g. dYdX authenticatorId (the on-chain authenticator record id)
  subaccountNumber Int?                             // e.g. dYdX subaccount number (default 0)
  // This row's data key, wrapped under the KEK named by kekVersion.
  dekEnc        String
  // Which master wrapped dekEnc. Not decoration: without it a half-finished
  // rotation is undetectable, and a row that FAILED to rotate is
  // indistinguishable from one that never needed to. It is also what makes
  // rotation resumable — the state lives here, in the data, not in the script.
  kekVersion    Int       @default(1)
  // What the venue reported AT VERIFICATION TIME — not necessarily what is true now.
  // Named ...AtVerify, and always displayed next to verifiedAt, because a user can
  // change a key's permissions at the venue after connecting it. Rendering these as
  // "current permissions" would be a claim we have not rechecked. Storing them at all
  // is only honest because we now genuinely read them from the venue before storing
  // (that was the objection to a permissions column when nothing read one).
  permissionsAtVerify String[] @default([])
  verifiedAt          DateTime?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?                           // set when a signing path first reads it (not yet built)
  revokedAt     DateTime?                           // non-null = retired; row is retained for audit

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Per-market liquidity-reward placement config — one row per (user, market).
// Paper-only: `mode` is always 'paper' until live execution ships
// (AUTO_EXECUTE_ENABLED=false). Read by agent27-news-guard to emit the advisory
// reaction the user chose (withdraw / alert / off). Never places a real order.
model RewardsPlacement {
  id         String   @id @default(cuid())
  userId     String
  marketId   String                              // Polymarket conditionId or Kalshi ticker
  venue      String                              // 'polymarket' | 'kalshi'
  side       String   @default("both")           // 'both' | 'buy' | 'sell'
  qtyPerSide Float    @default(1000)             // USD per side
  distanceC  Float    @default(2)                // distance from mid, in cents
  // Per-side fill-handling rule. When quoting BOTH sides the user picks a rule
  // independently for a YES fill vs a NO fill; single-sided placements set both to
  // the same value. Values: 'requote' (re-post the opposite side) | 'close' (flatten
  // at best executable book price). Legacy `onFill` retained one release for compat
  // ('flatten' == 'close'); new writes populate onFillYes/onFillNo.
  onFillYes  String   @default("requote")        // 'requote' | 'close' — rule on a YES-side fill
  onFillNo   String   @default("requote")        // 'requote' | 'close' — rule on a NO-side fill
  onFill     String   @default("requote")        // DEPRECATED legacy single field ('requote' | 'flatten')
  newsMode   String   @default("withdraw")       // 'withdraw' | 'alert' | 'off'
  mode       String   @default("paper")          // 'paper' only; live gated OFF
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, marketId])
}

// Copy-trading configuration — one row per (user, watched wallet). Paper-only:
// `mode` is always 'paper' until live execution ships (AUTO_EXECUTE_ENABLED).
// Slot limit (free=1 / pro=2) is enforced SERVER-SIDE by counting rows per user.
model CopyConfig {
  id               String   @id @default(cuid())
  userId           String
  walletAddr       String
  categories       String[] @default([])          // selected category filters (real, data-derived)
  pctPerOrder      Float    @default(5)            // % of each of the trader's orders to mirror (1–25)
  maxOpenPositions Int      @default(5)            // cap on simultaneously-open mirrored positions
  exitMode         String   @default("mirror")     // 'mirror' (exit with them) | 'tpsl' (own TP/SL)
  tpPct            Float?                           // take-profit %, only for exitMode='tpsl'
  slPct            Float?                           // stop-loss %,   only for exitMode='tpsl'
  mode             String   @default("paper")       // 'paper' only for now; 'live' gated OFF
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, walletAddr])
}

model UserPreferences {
  id            String   @id @default(cuid())
  userId        String   @unique
  minRoi        Float    @default(3.0)
  minConfidence Int      @default(60)
  platforms     String[] @default(["kalshi", "polymarket", "manifold", "predictit"])
  alertTypes    String[] @default(["prediction_market", "funding_rate", "cex_arb"])
  maxBankroll   Float    @default(1000)
  alertsEnabled Boolean  @default(true)
  emailAlerts   Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrackedOpportunity {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  platformA   String?
  platformB   String?
  roiPct      Float
  confidence  Int
  amountUsd   Float    @default(0)
  trackedAt   DateTime @default(now())
  result      String?
  pnlUsd      Float?
  resolvedAt  DateTime?
  notes       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Portfolio {
  id            String   @id @default(cuid())
  userId        String   @unique
  totalInvested Float    @default(0)
  totalPnl      Float    @default(0)
  winCount      Int      @default(0)
  lossCount     Int      @default(0)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Alert {
  id      String   @id @default(cuid())
  userId  String
  type    String
  message String
  sentAt  DateTime @default(now())
  read    Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  plan                 String
  price                Float     @default(0)
  startedAt            DateTime  @default(now())
  expiresAt            DateTime?
  stripeSubscriptionId String?
  status               String    @default("active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lead {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String
  createdAt DateTime @default(now())
}
