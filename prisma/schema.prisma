generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String?
  googleId            String?   @unique
  telegramChatId      String?
  alertPrefs          Json?
  name                String?
  plan                String    @default("free")
  planExpiresAt       DateTime?
  profitShareBalance  Float     @default(0)
  totalProfitTracked  Float     @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  preferences       UserPreferences?
  trackedOpps       TrackedOpportunity[]
  portfolio         Portfolio?
  alerts            Alert[]
  subscriptions     Subscription[]
}

model UserPreferences {
  id            String   @id @default(cuid())
  userId        String   @unique
  minRoi        Float    @default(3.0)
  minConfidence Int      @default(60)
  platforms     String[] @default(["kalshi", "polymarket", "manifold", "predictit"])
  alertTypes    String[] @default(["prediction_market", "funding_rate", "cex_arb"])
  maxBankroll   Float    @default(1000)
  alertsEnabled Boolean  @default(true)
  emailAlerts   Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrackedOpportunity {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  platformA   String?
  platformB   String?
  roiPct      Float
  confidence  Int
  amountUsd   Float    @default(0)
  trackedAt   DateTime @default(now())
  result      String?
  pnlUsd      Float?
  resolvedAt  DateTime?
  notes       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Portfolio {
  id            String   @id @default(cuid())
  userId        String   @unique
  totalInvested Float    @default(0)
  totalPnl      Float    @default(0)
  winCount      Int      @default(0)
  lossCount     Int      @default(0)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Alert {
  id      String   @id @default(cuid())
  userId  String
  type    String
  message String
  sentAt  DateTime @default(now())
  read    Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  plan                 String
  price                Float     @default(0)
  startedAt            DateTime  @default(now())
  expiresAt            DateTime?
  stripeSubscriptionId String?
  status               String    @default("active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lead {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String
  createdAt DateTime @default(now())
}
